{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "**",
      "!lib/generated",
      "!.next",
      "!evidence",
      "!bun.lock",
      "!next-env.d.ts",
      "!components/ui/button.tsx",
      "!components/ui/card.tsx",
      "!components/ui/input.tsx",
      "!components/ui/field.tsx",
      "!components/ui/empty.tsx",
      "!components/ui/dialog.tsx",
      "!components/ui/tabs.tsx",
      "!components/ui/badge.tsx",
      "!components/ui/separator.tsx",
      "!components/ui/spinner.tsx",
      "!components/ui/toggle.tsx",
      "!components/ui/toggle-group.tsx",
      "!components/ui/label.tsx",
      "!components/ui/aspect-ratio.tsx",
      "!components/ui/alert-dialog.tsx",
      "!components/ui/pagination.tsx",
      "!components/ui/questionnaire.tsx",
      "!components/ui/direction.tsx",
      "!components/ui/button-group.tsx",
      "!components/ui/slider.tsx",
      "!components/ui/input-group.tsx",
      "!components/ui/popover.tsx",
      "!components/ui/progress.tsx",
      "!components/ui/input-otp.tsx",
      "!components/ui/chart.tsx",
      "!components/ui/hover-card.tsx",
      "!components/ui/sheet.tsx",
      "!components/ui/scroll-area.tsx",
      "!components/ui/resizable.tsx",
      "!components/ui/navigation-menu.tsx",
      "!components/ui/accordion.tsx",
      "!components/ui/bubble.tsx",
      "!components/ui/drawer.tsx",
      "!components/ui/tooltip.tsx",
      "!components/ui/alert.tsx",
      "!components/ui/combobox.tsx",
      "!components/ui/switch.tsx",
      "!components/ui/calendar.tsx",
      "!components/ui/native-select.tsx",
      "!components/ui/breadcrumb.tsx",
      "!components/ui/radio-group.tsx",
      "!components/ui/command.tsx",
      "!components/ui/item.tsx",
      "!components/ui/avatar.tsx",
      "!components/ui/menubar.tsx",
      "!components/ui/kbd.tsx",
      "!components/ui/sidebar.tsx",
      "!components/ui/message.tsx",
      "!components/ui/table.tsx",
      "!components/ui/marker.tsx",
      "!components/ui/toast.tsx",
      "!components/ui/checkbox.tsx",
      "!components/ui/collapsible.tsx",
      "!components/ui/dropdown-menu.tsx",
      "!components/ui/select.tsx",
      "!components/ui/textarea.tsx",
      "!components/ui/message-scroller.tsx",
      "!components/ui/attachment.tsx",
      "!components/ui/skeleton.tsx",
      "!components/ui/context-menu.tsx",
      "!components/ui/carousel.tsx"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["app/globals.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": ["components/code-block.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveTabindex": "off"
          }
        }
      }
    }
  ]
}
